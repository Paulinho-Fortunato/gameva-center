```gitignore
# Compiled and build artifacts
*.js
*.jsx
*.ts
*.tsx
*.css
*.scss
*.sass
*.less
*.map

# Dependencies
node_modules/

# Build directories
dist/
build/
coverage/

# Environment variables
.env
.env.local
.env.*

# Logs
*.log

# Editor files
.vscode/
.idea/
*.swp
*.swo
*.tmp

# OS files
.DS_Store
Thumbs.db

# Python cache (if present)
__pycache__/
*.pyc
*.pyo
*.pyd

# Test coverage
.coverage
htmlcov/

# Distribution / packaging
*.tar.gz
*.zip
*.egg-info/
```